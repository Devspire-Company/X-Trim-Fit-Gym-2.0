{
	"cli": {
		"version": ">= 18.0.6",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal"
		},
		"preview": {
			"distribution": "internal",
			"env": {
				"NPM_CONFIG_LEGACY_PEER_DEPS": "true"
			},
			"android": {
				"buildType": "app-bundle"
			}
		},
		"production": {
			"autoIncrement": true,
			"env": {
				"NPM_CONFIG_LEGACY_PEER_DEPS": "true"
			},
			"android": {
				"buildType": "apk"
			}
		}
	},
	"submit": {
		"production": {}
	}
}
