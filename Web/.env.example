# Copy this file to ".env" in the project root and fill in values.
# Local dev defaults point to api-clean (`localhost:8000`) when these are omitted.
# Set these explicitly if you need to target another backend (for example Render).

VITE_GRAPHQL_URL=http://localhost:8000/graphql
VITE_GRAPHQL_WS_URL=ws://localhost:8000/graphql
# VITE_GRAPHQL_URL=https://xtrimfitgym-api.onrender.com/graphql
# VITE_GRAPHQL_WS_URL=wss://xtrimfitgym-api.onrender.com/graphql

# Must match the Clerk instance your API validates (pk_test_… vs pk_live_…).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_cG9saXNoZWQtY29sdC05MS5jbGVyay5hY2NvdW50cy5kZXYk

# Optional compatibility switch:
# - default behavior is modern API mode (recommended for deployed domain)
# - set to "false" only when temporarily forcing legacy equipment/archive behavior
# VITE_ENABLE_MODERN_ARCHIVE_API=false
VITE_ENABLE_SYSTEM_NOTIFICATIONS=true
