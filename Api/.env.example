NODE_ENV=development
PORT=8000
DB_URI=mongodb://127.0.0.1:27017/xtrimfitgym
JWT_SECRET=replace_with_at_least_32_random_characters
CLERK_SECRET_KEY=sk_test_replace_me
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8081

# Optional image uploads; configure all three together.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server-side ExerciseDB proxy.
EXERCISEDB_API_KEY=

# Attendance database. Use the read-only xtrim_api account for the API.
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=xtrim_api
MYSQLPASSWORD=
MYSQLDATABASE=railway

MEMBERSHIP_EXPIRING_DAYS=7
NOTIFICATION_CHECK_INTERVAL_MINUTES=60
